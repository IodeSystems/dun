{
  "name": "dun-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "graphql-codegen --config codegen.ts && tsc --noEmit && tsc -p public/tsconfig.json",
    "lint": "oxlint --type-aware",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "gen": "graphql-codegen --config codegen.ts",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.test.ts",
      "**/test/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~58.0.19",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "graphql": "^17.0.0",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
