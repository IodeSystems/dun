{
  "name": "dun-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "graphql-codegen --config codegen.ts && tsc --noEmit && tsc -p public/tsconfig.json",
    "lint": "oxlint --type-aware",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "gen": "graphql-codegen --config codegen.ts",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@localix-ai/flowdown))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "testMatch": [
      "**/test/**/*.test.ts",
      "**/test/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-native/(react-private-interface|setup-env)$": "<rootDir>/node_modules/react-native/src/$1.js"
    }
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.17",
    "@localix-ai/flowdown": "0.7.1",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-application": "~58.1.2",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "graphql": "^16.15.0",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.4.2",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/client-preset": "^7.0.0",
    "@types/jest": "30.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.3.0",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "test-renderer": "1.3.0",
    "typescript": "^7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
