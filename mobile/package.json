{
  "name": "dun-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "graphql-codegen --config codegen.ts && tsc --noEmit && tsc -p public/tsconfig.json",
    "lint": "oxlint --type-aware",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android",
    "gen": "graphql-codegen --config codegen.ts",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/test/**/*.test.ts",
      "**/test/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint-plugin-expo": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
