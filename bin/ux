#!/usr/bin/env bash
# bin/ux — walk dun as a person arriving at it, and write down only what they
# could see.
#
#   bin/ux                  the default walk (ux/walks/onboarding.json)
#   bin/ux <walk>           ux/walks/<walk>.json
#   bin/ux --list           the walks and scenarios on disk
#   bin/ux --keep           keep the scratch directory (HOME, logs) for debugging
#   bin/ux --size 48x24     walk at this size only (repeatable); replaces the
#                           walk's "sizes" (or its cols/rows; neither = 100x30)
#
# Output: one run directory per size, tmp/ux-run-<walk>-<stamp>-<cols>x<rows>/
# — per step NN-<id>.png and NN-<id>.txt, run.json, BRIEF.md, ACTIONS.md, the
# recording (<walk>.cast) and <walk>.gif. Each size is its own arrival (a
# fresh HOME, a fresh stub), and each brief names only its own directory's
# files, so a persona reads one size as one visit.
#
# THE PERSONAS ARE THE CONSTANT (~/doc/patterns/lenny.md LEN-1, george.md,
# design.md's critic as Ives). Who they are lives in .claude/agents/; the
# scenario in ux/scenarios/ varies their goal and role and may not soften them.
#
# THE OUTPUT IS THE POINT AND IT IS SELF-CONTAINED (LEN-2). BRIEF.md names
# every file an evaluator may read. An evaluator who has read cmd/dun cannot
# un-know what "standalone" or "scripted" means, and would pass the
# vocabulary questions forever.
#
# HERMETIC, and never near the real one: a scratch HOME (so ~/.dun is
# $SCRATCH/home/.dun, with its own dund socket and launcher socket), a clean
# environment (env -i: no DUN_* or TMUX from the shell running this), a stub
# LLM on a port asked of the kernel (never raglit's 7420), a stub MCP server,
# and a dun built from this checkout. Every process the run started is killed
# by path on exit. Nothing reads or writes ~/.dun or talks to the real dund.
#
# THE ARRIVAL IS A REAL ONE (LEN-4). A harness that starts the person in an
# impossible state fails in the direction that blames the product. So:
#   - the project is a git repository with history and an author, because
#     that is what a person who "looks after a program" has; an empty folder
#     would put dun's "not a repository" path on screen, which nobody arrives at.
#   - dun is installed and has never run: no ~/.dun at all.
#   - mcpshell is on PATH when this machine has it, because dun's README says
#     an install must put it there; raglit and poly-lsp-mcp are not, because
#     the README says they are only for /raglit and /poly-lsp.
#   - the walk types a provider address and key (the stub's) and the server
#     command notes-mcp, which is what the scenario's colleague wrote down.
#   - the build is stamped with this checkout's version but no source dir, as
#     a release build is, so dun never tries to update itself mid-walk.
#
# NOT part of `make test`: it builds dun and runs it for about a minute.
set -euo pipefail
cd "$(dirname "$0")/.."

WALK="onboarding"
KEEP=0
SIZE_ARGS=()
while [ $# -gt 0 ]; do
  arg="$1"; shift
  case "$arg" in
    --keep) KEEP=1 ;;
    --size) [ $# -gt 0 ] || { echo "bin/ux: --size needs COLSxROWS" >&2; exit 2; }
      SIZE_ARGS+=(-size "$1"); shift ;;
    --size=*) SIZE_ARGS+=(-size "${arg#--size=}") ;;
    --list)
      echo "walks:";     ls ux/walks     2>/dev/null | sed 's/\.json$//;s/^/  /'
      echo "scenarios:"; ls ux/scenarios 2>/dev/null | sed 's/\.md$//;s/^/  /'
      exit 0 ;;
    -h|--help) sed -n '2,16p' "$0"; exit 0 ;;
    -*) echo "bin/ux: unknown option $arg" >&2; exit 2 ;;
    *) WALK="$arg" ;;
  esac
done

die() { echo "bin/ux: $*" >&2; exit 1; }

WALKFILE="ux/walks/$WALK.json"
[ -f "$WALKFILE" ] || die "no such walk: $WALKFILE (bin/ux --list)"
command -v jq >/dev/null || die "jq is not on PATH"
SCENARIO="$(jq -r .scenario "$WALKFILE")"
SCENFILE="ux/scenarios/$SCENARIO.md"
[ -f "$SCENFILE" ] || die "the walk names scenario $SCENARIO but $SCENFILE does not exist"

SCRATCH="$(mktemp -d /tmp/dun-ux-XXXXXX)"
BIN="$SCRATCH/bin"
mkdir -p "$BIN"

stop_run() {
  [ -n "${STUB_PID:-}" ] && kill "$STUB_PID" 2>/dev/null || true
  STUB_PID=""
  # dun starts a launcher and dund that outlive the TUI; each runs from $BIN.
  pkill -TERM -f "^$BIN/" 2>/dev/null || true
  sleep 0.5
  pkill -KILL -f "^$BIN/" 2>/dev/null || true
}
cleanup() {
  stop_run
  if [ "$KEEP" = 1 ]; then echo "bin/ux: kept $SCRATCH" >&2; else rm -rf "$SCRATCH"; fi
}
trap cleanup EXIT

VERSION="$(git describe --tags --always --dirty 2>/dev/null || echo dev)"
echo "bin/ux: building dun $VERSION" >&2
go build -ldflags "-X main.version=$VERSION" -o "$BIN/dun" ./cmd/dun || die "could not build dun"
go build -o "$SCRATCH/ux" ./tools/ux || die "could not build tools/ux"
(cd tools/ttyrec && go build -o "$SCRATCH/ttyrec" .) || die "could not build tools/ttyrec"
ln -s "$SCRATCH/ux" "$BIN/notes-mcp"
BASE_NOTES=()
if MS="$(command -v mcpshell)"; then
  ln -s "$MS" "$BIN/mcpshell"
  BASE_NOTES+=("mcpshell is on PATH (from this machine: $MS), as dun's README requires of an install")
else
  BASE_NOTES+=("mcpshell is NOT on PATH (this machine has none); dun's README requires it, so its absence is the harness's, not the product's")
fi

SIZES="$("$SCRATCH/ux" sizes -walk "$WALKFILE" "${SIZE_ARGS[@]}")" || die "bad sizes"
STAMP="$(date +%Y%m%d-%H%M%S)"

# walk_one COLS ROWS N: one arrival at one size, into its own run directory.
walk_one() {
  local cols="$1" rows="$2" n="$3"
  local tag="${cols}x${rows}"
  # Short, because the socket path must fit in 107 bytes and because it is
  # on screen (the brief tells the reader it belongs to the test).
  local FAKEHOME="$SCRATCH/h$n"
  local RUN="$SCRATCH/r$n"
  mkdir -p "$FAKEHOME" "$RUN"
  local NOTES=("${BASE_NOTES[@]}")

  # The project, as its owner has it: a repository with a history.
  local PROJECT="$FAKEHOME/greet"
  mkdir -p "$PROJECT"
  printf '# greet\n\nPrints a greeting for the team.\n\n    go run .\n' >"$PROJECT/README.md"
  printf 'package main\n\nimport "fmt"\n\nfunc main() {\n\tfmt.Println("hello, team")\n}\n' >"$PROJECT/main.go"
  printf 'module example.invalid/greet\n\ngo 1.22\n' >"$PROJECT/go.mod"
  (
    cd "$PROJECT"
    export HOME="$FAKEHOME" GIT_CONFIG_NOSYSTEM=1
    export GIT_AUTHOR_NAME=Sam GIT_AUTHOR_EMAIL=sam@example.invalid GIT_COMMITTER_NAME=Sam GIT_COMMITTER_EMAIL=sam@example.invalid
    git init -q -b main
    git add README.md go.mod && GIT_AUTHOR_DATE=2026-09-01T10:00:00 GIT_COMMITTER_DATE=2026-09-01T10:00:00 git commit -qm "start greet"
    git add main.go && GIT_AUTHOR_DATE=2026-09-14T16:20:00 GIT_COMMITTER_DATE=2026-09-14T16:20:00 git commit -qm "say hello to the team"
  ) || die "could not seed the project"
  NOTES+=("the project ~/greet is a git repository with 2 commits by its owner; ~/.dun does not exist before the walk")

  # The stub LLM, on a port the kernel picks.
  "$SCRATCH/ux" llm --port-file "$RUN/llm.addr" --log "$RUN/llm.log" 2>"$RUN/llm.err" &
  STUB_PID=$!
  for _ in $(seq 1 50); do [ -s "$RUN/llm.addr" ] && break; sleep 0.1; done
  [ -s "$RUN/llm.addr" ] || die "the stub LLM did not start: $(cat "$RUN/llm.err")"
  local LLM_URL="http://$(cat "$RUN/llm.addr")/v1"
  NOTES+=("the AI service is a stub on 127.0.0.1 that lists 7 models and gives fixed answers")
  NOTES+=("dun was started as \`dun\` in the project folder, in a ${WALK} walk at ${cols}×${rows}, driven by tools/ttyrec")

  OUT="tmp/ux-run-$WALK-$STAMP-$tag"
  mkdir -p "$OUT"
  local OUTABS
  OUTABS="$(cd "$OUT" && pwd)"

  echo "bin/ux: walking $WALK at $tag" >&2
  set +e
  (
    cd "$PROJECT"
    env -i HOME="$FAKEHOME" DUN_HOME="$FAKEHOME/.dun" PATH="$BIN:/usr/local/bin:/usr/bin:/bin" \
      USER=sam LOGNAME=sam SHELL=/bin/bash LANG=C.UTF-8 TERM=xterm-256color COLORTERM=truecolor \
      DUN_NO_BROWSER=1 DUN_NO_AUTOBUILD=1 GIT_CONFIG_NOSYSTEM=1 \
      LLM_URL="$LLM_URL" LLM_KEY="sk-team-7f3a" \
      "$SCRATCH/ttyrec" rec -script "$OLDPWD/$WALKFILE" -cols "$cols" -rows "$rows" -result "$RUN/rec.json" \
        -title "dun — $WALK" -o "$OUTABS/$WALK.cast" -- dun
  )
  REC=$?
  set -e
  stop_run
  [ -f "$RUN/rec.json" ] || die "the recorder wrote no result at $tag (exit $REC)"

  "$SCRATCH/ttyrec" render -gif "$OUT/$WALK.gif" -marks "$OUT" "$OUT/$WALK.cast" >/dev/null || die "render failed at $tag"
  # The harness's own logs, for whoever debugs a run; not in the brief.
  cp "$RUN/llm.log" "$OUT/harness-llm.log" 2>/dev/null || true
  cp "$FAKEHOME/.dun/dund.log" "$OUT/harness-dund.log" 2>/dev/null || true
  local NOTE_ARGS=()
  for note in "${NOTES[@]}"; do NOTE_ARGS+=(-note "$note"); done
  "$SCRATCH/ux" assemble -walk "$WALKFILE" -scenario "$SCENFILE" -run "$OUT" -result "$RUN/rec.json" \
    -size "$tag" -stamp "$STAMP" -version "$VERSION" -cast "$WALK.cast" "${NOTE_ARGS[@]}" || die "assemble failed at $tag"
}

OUTS=()
FAILED=0
N=0
while read -r cols rows; do
  N=$((N + 1))
  walk_one "$cols" "$rows" "$N"
  if [ "$REC" = 0 ]; then
    OUTS+=("$OUT")
  else
    OUTS+=("$OUT  (THE WALK STOPPED EARLY — see run.json .error)")
    FAILED=1
  fi
done <<<"$SIZES"

echo
for o in "${OUTS[@]}"; do echo "bin/ux: $o"; done
cat <<EOF

  Hand ONE directory to the scoped evaluators and nothing else; each size is
  its own visit:

      Agent(subagent_type: "lenny",  prompt: "Evaluate the run in ${OUTS[0]%%  *}. Read BRIEF.md first.")
      Agent(subagent_type: "george", prompt: "Evaluate the run in ${OUTS[0]%%  *}. Read BRIEF.md first.")
      Agent(subagent_type: "ives",   prompt: "Evaluate the run in ${OUTS[0]%%  *}. Read BRIEF.md first.")

EOF
exit "$FAILED"
